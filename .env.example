# Names only. Real values live in Vercel environment variables (never commit them).

# Core
DATABASE_URL=
SESSION_SECRET=
CRON_SECRET=
APP_URL=

# File storage (Vercel Blob, private)
BLOB_READ_WRITE_TOKEN=

# PayU, one pair per merchant key named on projects.payu_env_key (e.g. PAYU_SIPANI)
PAYU_MODE=test
PAYU_SIPANI_KEY=
PAYU_SIPANI_SALT=

# WhatsApp, same naming as the dashboard.flowrealty.in/api/wa relay
DOUBLETICK_API_KEY=
GALLABOX_RIVERINE_KEY=
GALLABOX_RIVERINE_SECRET=
GALLABOX_GEOWN_KEY=
GALLABOX_GEOWN_SECRET=

# SMS OTP fallback (provider to be chosen)
SMS_PROVIDER=
SMS_API_KEY=

# Totality CRM, one pair per project, named on projects.totality_env_key (e.g. TOTALITY_SIPANI)
TOTALITY_SIPANI_USER=
TOTALITY_SIPANI_PASSWORD=
TOTALITY_SUMADHURA_USER=
TOTALITY_SUMADHURA_PASSWORD=
TOTALITY_RIVERINE_USER=
TOTALITY_RIVERINE_PASSWORD=
TOTALITY_GEOWN_USER=
TOTALITY_GEOWN_PASSWORD=
